<!-- Loading the plugin dynamically leaves the previews blank until a restart, so ask for one. -->
<idea-plugin require-restart="true">
    <id>dev.nucleusframework.compose-swiftui</id>
    <name>Compose SwiftUI</name>
    <vendor url="https://github.com/NucleusFramework/ComposeSwiftUI">Nucleus Framework</vendor>
    <description><![CDATA[
        Shows the Compose SwiftUI <code>@Preview</code> composables next to the code, rendered with real SwiftUI
        on the iOS simulator by the <code>renderComposeSwiftUIPreviews</code> Gradle task.
        <ul>
            <li>Split code and preview editor, with list, grid and gallery layouts, zoom and group filter</li>
            <li>Renders on save or while typing, only the previews of the open file, in parallel</li>
            <li><code>@Preview</code> variants (color scheme, Dynamic Type, locale, layout direction, size, device),
                multipreview annotations and <code>@PreviewParameter</code></li>
            <li>Run a preview live on the simulator, navigate between code and previews, copy or save images</li>
            <li>Compile errors and preview crashes shown next to the previews; inspections for previews that
                can't render</li>
            <li>Tools for AI agents on the IDE's MCP server: list, render, render throwaway code, UI checks, compare
                with a design or a folder of screenshots</li>
        </ul>
        Needs macOS with Xcode, or, on Linux and Windows, a Mac reached over SSH (Settings › Tools › Compose SwiftUI
        Previews › Remote Mac), and the <code>dev.nucleusframework.compose-swiftui</code> Gradle plugin.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.gradle</depends>
    <!-- The previews as tools for AI agents connected to the IDE's MCP server. -->
    <depends optional="true" config-file="compose-swiftui-mcp.xml">com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="dev.nucleusframework.composeswiftui.idea.PreviewEditorProvider"/>
        <!-- A simulator of the Mac (this one or the remote one, from Linux or Windows) live in the IDE. -->
        <toolWindow id="iOS Simulator" anchor="right" secondary="false" icon="AllIcons.Nodes.Deploy"
                    factoryClass="dev.nucleusframework.composeswiftui.idea.SimulatorToolWindowFactory"/>
        <configurationType implementation="dev.nucleusframework.composeswiftui.idea.IosRunConfigurationType"/>
        <executionTargetProvider implementation="dev.nucleusframework.composeswiftui.idea.IosSimulatorTargetProvider"/>
        <postStartupActivity implementation="dev.nucleusframework.composeswiftui.idea.IosRunConfigurationCreator"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.nucleusframework.composeswiftui.idea.PreviewLineMarkerProvider"/>
        <localInspection language="kotlin" shortName="ComposeSwiftUIPreview"
                         displayName="Compose SwiftUI preview that won't be rendered"
                         groupName="Compose SwiftUI" enabledByDefault="true" level="WARNING"
                         implementationClass="dev.nucleusframework.composeswiftui.idea.PreviewInspection"/>
        <!-- The agent tools on the plugin's own MCP server, for IDEs without JetBrains' (Android Studio). -->
        <postStartupActivity implementation="dev.nucleusframework.composeswiftui.idea.mcp.StandaloneMcpServerStarter"/>
        <applicationConfigurable parentId="tools" id="dev.nucleusframework.composeswiftui.previews"
                                 displayName="Compose SwiftUI Previews"
                                 instance="dev.nucleusframework.composeswiftui.idea.PreviewConfigurable"/>
    </extensions>

    <actions>
        <action id="ComposeSwiftUI.RenderPreviews" class="dev.nucleusframework.composeswiftui.idea.RenderPreviewsAction"
                text="Render Compose SwiftUI Previews" description="Render the previews of this file on the iOS simulator"
                icon="AllIcons.Actions.Refresh">
            <add-to-group group-id="CodeMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift P"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift P" replace-all="true"/>
        </action>
        <action id="ComposeSwiftUI.RenderModulePreviews" class="dev.nucleusframework.composeswiftui.idea.RenderModulePreviewsAction"
                text="Render All Compose SwiftUI Previews of the Module"
                description="Render every preview of the module of this file on the iOS simulator">
            <add-to-group group-id="CodeMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
