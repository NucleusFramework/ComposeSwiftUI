<idea-plugin>
    <id>dev.nucleusframework.compose-swiftui</id>
    <name>Compose SwiftUI</name>
    <vendor url="https://github.com/NucleusFramework/ComposeSwiftUI">Nucleus Framework</vendor>
    <description><![CDATA[
        Shows the Compose SwiftUI <code>@Preview</code> composables next to the code, rendered with real SwiftUI
        on the iOS simulator by the <code>renderComposeSwiftUIPreviews</code> Gradle task.
        Needs macOS with Xcode, and the <code>dev.nucleusframework.compose-swiftui</code> Gradle plugin.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.gradle</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="dev.nucleusframework.composeswiftui.idea.PreviewEditorProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="dev.nucleusframework.composeswiftui.idea.PreviewLineMarkerProvider"/>
    </extensions>
</idea-plugin>
